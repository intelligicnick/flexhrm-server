{
  "name": "flex-hrm-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Flex HRM — NestJS API with MongoDB",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/write-hostinger-entry.cjs",
    "verify:hostinger": "node scripts/verify-hostinger-dist.mjs",
    "start": "node dist/server.js",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/server.js",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "migrate:json": "tsx scripts/migrate-from-json.ts",
    "migrate:multi-tenant": "tsx scripts/migrate-to-multi-tenant.ts",
    "migrate:tenant-indexes": "tsx scripts/rebuild-tenant-indexes.ts",
    "seed:amour": "tsx scripts/seed-amour-schools.ts",
    "test:smtp": "tsx scripts/test-smtp.ts"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.8.0",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/throttler": "^6.4.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "mongoose": "^8.13.2",
    "nodemailer": "^9.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.3",
    "tsx": "^4.21.0"
  }
}
