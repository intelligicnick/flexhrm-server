# Copy each line into Hostinger hPanel → Node.js app → Environment variables.
# Do NOT upload this file to the server. Do NOT commit real passwords to git.
# Replace placeholder values with your production secrets.

NODE_ENV=production
# Do NOT set PORT manually — Hostinger injects process.env.PORT at runtime.
# The app listens on: Number(process.env.PORT) || 3000

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/flexhrm?retryWrites=true&w=majority
CORS_ORIGINS=https://greenyellow-woodpecker-750354.hostingersite.com

SEED_ON_STARTUP=false

# Gmail SMTP (App Password — https://myaccount.google.com/apppasswords)
SMTP_SERVICE=gmail
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Flex HRM <your-gmail@gmail.com>

# Optional — ImageKit for persistent file storage
# IMAGEKIT_PUBLIC_KEY=public_...
# IMAGEKIT_PRIVATE_KEY=private_...
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Required for School Google Maps Pins (Places API New + Geocoding API in Google Cloud)
# GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Browser key for Maps JavaScript API (supervisor APK WebView + admin web)
# Restrict to HTTP referrers: https://*.hostingersite.com/* and https://appassets.androidplatform.net/*
# GOOGLE_MAPS_JS_API_KEY=your-maps-javascript-api-key
