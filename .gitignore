# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Test / coverage
coverage/

# Environment & secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & editor
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Local overrides
*.local

# Archived Axis Bulk Pay Excel files (generated at runtime)
data/bulk-pay-exports/*
!data/bulk-pay-exports/.gitkeep

# Employee uploads (photos, documents, ID cards — generated at runtime)
data/employee-assets/

# Python cache
scripts/__pycache__/
