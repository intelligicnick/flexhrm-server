# Server
PORT=3001
NODE_ENV=development

# ── Local development ──────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/hrmcom
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Production / Hostinger (set in hPanel → Environment, NOT in .env file) ─
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/flexhrm?retryWrites=true&w=majority
# CORS_ORIGINS=https://greenyellow-woodpecker-750354.hostingersite.com
# (API deployed at https://mediumseagreen-chimpanzee-998149.hostingersite.com)
# SEED_ON_STARTUP=true
# DEFAULT_ADMIN_PASSWORD=change-me-before-deploy

# JSON migration source directory (resolved from backend/)
# Use ../../ to read *-db.json from Desktop when files sit beside the flexhrm folder
MIGRATE_SOURCE_DIR=../../

# Directory for archived Axis Bulk Pay Excel files (optional — use a path
# outside the deploy folder for faster disk reads; file content is also stored
# in MongoDB so View Excel / Re-download work after Hostinger redeploys).
# Default: backend/data/bulk-pay-exports (ephemeral on Hostinger Node hosting)
# BULK_PAY_EXPORT_DIR=/home/youruser/flexhrm-data/bulk-pay-exports

# Employee photos and ID cards (optional persistent storage outside deploy folder)
# EMPLOYEE_ASSETS_DIR=/home/youruser/flexhrm-data/employee-assets

# Renewal / BG-DD document disk cache (optional — ImageKit is used when configured)
# RENEWAL_ASSETS_DIR=/home/youruser/flexhrm-data/renewal-assets

# ImageKit — cloud storage for images and PDFs (employee docs, renewals, visits, etc.)
# Get keys from https://imagekit.io/dashboard/developer/api-keys
# IMAGEKIT_PUBLIC_KEY=public_...
# IMAGEKIT_PRIVATE_KEY=private_...
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Optional reverse-geocoding fallbacks for visit photo place names (when OSM has no village/street data)
# GOOGLE_GEOCODING_API_KEY=your-google-geocoding-api-key
# OPENCAGE_API_KEY=your-opencage-api-key

# COMPANY_NAME=INTELLIGIC SOLUTIONS
# COMPANY_ADDRESS=Head Office: F-164, B Wing Express Zone, Western Express Hwy, Malad East, Mumbai, Maharashtra 400097
# COMPANY_PHONE=9029965109
# COMPANY_EMAIL=info@intelligic.co.in

# SMTP (optional — enables password-reset codes by email)
# Set these in Hostinger hPanel → Environment for production (not in a .env file on the server).
# Gmail (recommended — use an App Password, not your regular Gmail password):
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create App Password: https://myaccount.google.com/apppasswords (Mail → Other → Flex HRM)
# SMTP_SERVICE=gmail
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=Flex HRM <your-gmail@gmail.com>
# Optional overrides (defaults work for Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
#
# Brevo example (STARTTLS on 587):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-id@smtp-brevo.com
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM="Flex HRM <no-reply@yourdomain.org>"   # must be a verified sender in Brevo
# Hostinger example:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@yourdomain.com
# SMTP_PASS=your-mailbox-password
# ID_CARD_VERIFY_BASE_URL=https://greenyellow-woodpecker-750354.hostingersite.com/employee

# ESSL biometric bridge (essl-attendance/sync_service.py on Windows LAN)
# ESSL_SYNC_API_KEY=generate-a-long-random-secret

# ARCHIVE_DATA_DIR=/home/youruser/flexhrm-data/archive
# ARCHIVE_RETENTION_MONTHS=6
# ARCHIVE_AUTO_RUN=true

# Seed default admin on empty database
SEED_ON_STARTUP=true
DEFAULT_ADMIN_PASSWORD=admin123

# SaaS Platform
PLATFORM_ADMIN_PASSWORD=PlatformAdmin@2026
AUDIT_FLUSH_PASSWORD=your-secure-audit-flush-password
DEFAULT_TRIAL_DAYS=14
PLATFORM_DOMAIN=flexhrm.com

# Payment Gateways (optional)
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Redis (optional — for multi-instance deployments)
# REDIS_URL=redis://127.0.0.1:6379

# WhatsApp notifications (meta = Meta Cloud API, twilio = Twilio, disabled = log only)
# WHATSAPP_PROVIDER=disabled
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
