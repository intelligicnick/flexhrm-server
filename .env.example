# Server
PORT=3001
NODE_ENV=development

# ── Local development ──────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/flexhrm
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Production / Hostinger (set in hPanel → Environment, NOT in .env file) ─
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/flexhrm?retryWrites=true&w=majority
# CORS_ORIGINS=https://greenyellow-woodpecker-750354.hostingersite.com
# (API deployed at https://midnightblue-partridge-476451.hostingersite.com)
# SEED_ON_STARTUP=true
# DEFAULT_ADMIN_PASSWORD=change-me-before-deploy

# JSON migration source directory (resolved from backend/)
# Use ../../ to read *-db.json from Desktop when files sit beside the flexhrm folder
MIGRATE_SOURCE_DIR=../../

# Directory for archived Axis Bulk Pay Excel files (optional — use a path
# outside the deploy folder for faster disk reads; file content is also stored
# in MongoDB so View Excel / Re-download work after Hostinger redeploys).
# Default: backend/data/bulk-pay-exports (ephemeral on Hostinger Node hosting)
# BULK_PAY_EXPORT_DIR=/home/youruser/flexhrm-data/bulk-pay-exports

# Employee photos and ID cards (optional persistent storage outside deploy folder)
# EMPLOYEE_ASSETS_DIR=/home/youruser/flexhrm-data/employee-assets
# COMPANY_NAME=INTELLIGIC SOLUTIONS
# COMPANY_ADDRESS=Head Office: F-164, B Wing Express Zone, Western Express Hwy, Malad East, Mumbai, Maharashtra 400097
# COMPANY_PHONE=9029965109
# COMPANY_EMAIL=info@intelligic.co.in

# SMTP (optional — enables password-reset codes by email)
# Mailtrap example (STARTTLS on 587):
# SMTP_HOST=live.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=api
# SMTP_PASS=your-mailtrap-api-token
# SMTP_FROM="Flex HRM <noreply@yourdomain.com>"
# Hostinger example:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@yourdomain.com
# SMTP_PASS=your-mailbox-password
# ID_CARD_VERIFY_BASE_URL=https://greenyellow-woodpecker-750354.hostingersite.com/employee

# ARCHIVE_DATA_DIR=/home/youruser/flexhrm-data/archive
# ARCHIVE_RETENTION_MONTHS=6
# ARCHIVE_AUTO_RUN=true

# Seed default admin on empty database
SEED_ON_STARTUP=true
DEFAULT_ADMIN_PASSWORD=admin123
